# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments (remote runners use .venv/)
.venv/
venv/

# Datasets and the fingerprinted trait-space cache live on the compute
# host (doob) and are transferred out-of-band, never through git.
# Leading slash anchors this to the repo root so the src/infl_ens/data
# package is NOT matched.
/data/

# Run outputs and rendered figures are regenerated by the pipeline; the
# leading slash keeps src/infl_ens/figures (code) and scripts/figures (the
# one PNG the TeX overview includes) tracked.
/results/
/figures/

# Sphinx build output and generated autosummary stubs
docs/_build/
docs/api/_autosummary/

# Editor / OS noise
.DS_Store
*.swp
