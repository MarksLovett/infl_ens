%% iclr2026_conference.sty
%%
%% Self-contained reimplementation of the ICLR conference style, written because
%% the official file is not installed on this machine. It reproduces the
%% published layout: US letter, 0.5in side margins, 5.5in x 9in text block,
%% Times, natbib author-year citations, and the "Under review as a conference
%% paper at ICLR 2026" running head with the review-copy line numbers.
%%
%% To switch to the official template, drop iclr2026_conference.sty from the
%% ICLR master template into this directory. main.tex needs no changes: it uses
%% only \iclrfinalcopy, \author, \title, \maketitle and the abstract environment,
%% all of which the official file provides with the same names.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{iclr2026_conference}[2026/01/01 ICLR 2026 conference style]

\RequirePackage{eso-pic}
\RequirePackage{fancyhdr}
\RequirePackage{natbib}
\RequirePackage{times}

% Author-year citations, as ICLR uses.
\setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}

% ---------------------------------------------------------------- page layout
\paperwidth=8.5in
\paperheight=11in
\oddsidemargin 0in
\evensidemargin 0in
\marginparwidth 0.5in
\marginparsep 0.25in
\topmargin -0.5in
\headheight 0.2in
\headsep 0.3in
\footskip 0.4in
\textheight 9.0in
\textwidth 5.5in
\columnsep 0.25in
\parindent 0pt
\parskip 0.7\baselineskip plus 0.15\baselineskip minus 0.1\baselineskip

% Compact spacing, as in the official style.
\renewcommand{\baselinestretch}{1.0}
\setlength{\floatsep}{10pt plus 2pt minus 2pt}
\setlength{\textfloatsep}{12pt plus 2pt minus 4pt}
\setlength{\intextsep}{10pt plus 2pt minus 2pt}
\setlength{\abovedisplayskip}{8pt plus 2pt minus 2pt}
\setlength{\belowdisplayskip}{8pt plus 2pt minus 2pt}

% ------------------------------------------------- final copy vs review copy
\newif\if@iclrfinal\@iclrfinalfalse
\def\iclrfinalcopy{\@iclrfinaltrue}
\newcommand{\iclrheading}{%
  \if@iclrfinal Published as a conference paper at ICLR 2026%
  \else Under review as a conference paper at ICLR 2026\fi}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[L]{\footnotesize\iclrheading}
\fancyfoot[C]{\thepage}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyhead[L]{\footnotesize\iclrheading}%
  \fancyfoot[C]{\thepage}}

% ------------------------------------------------------------ title and author
\def\@maketitle{\vbox{\hsize\textwidth
    \linewidth\hsize \vskip 0.1in \centering
    {\LARGE\bf \@title\par} \vskip 0.2in
    {\def\And{\end{tabular}\hfil\hskip 2em plus 1em\hfil\begin{tabular}[t]{c}\bf\rule{\z@}{24pt}\ignorespaces}%
     \def\AND{\end{tabular}\hfil\linebreak[4]\hfil\begin{tabular}[t]{c}\bf\rule{\z@}{24pt}\ignorespaces}%
     \begin{tabular}[t]{c}\bf\rule{\z@}{24pt}\@author\end{tabular}}%
    \vskip 0.3in \@minus 0.1in}}

\renewcommand{\maketitle}{%
  \par
  \begingroup
    \renewcommand{\thefootnote}{\fnsymbol{footnote}}%
    \@maketitle
    \thispagestyle{plain}\@thanks
  \endgroup
  \setcounter{footnote}{0}%
  \global\let\thanks\relax
  \global\let\maketitle\relax
  \global\let\@maketitle\relax
  \global\let\@thanks\@empty
  \global\let\@author\@empty
  \global\let\@title\@empty}

% Anonymous author block for the double-blind submission version.
\newcommand{\iclranonymous}{%
  \author{Anonymous authors\\Paper under double-blind review}}

% -------------------------------------------------------------------- abstract
\renewenvironment{abstract}{%
  \centerline{\large\bf Abstract}%
  \vspace{0.5ex}%
  \begin{quote}}{\par\end{quote}\vskip 0.5ex}

% ------------------------------------------------------------------- sectioning
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-2.0ex \@plus -0.5ex \@minus -0.2ex}%
  {1.5ex \@plus 0.3ex \@minus 0.2ex}%
  {\large\bf\raggedright}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-1.8ex \@plus -0.5ex \@minus -0.2ex}%
  {0.8ex \@plus 0.2ex}%
  {\normalsize\bf\raggedright}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex \@plus -0.5ex \@minus -0.2ex}%
  {0.5ex \@plus 0.2ex}%
  {\normalsize\bf\raggedright}}

\endinput
